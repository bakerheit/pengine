  "cues": [
    {
      "speaker": "Johnny",
      "text": "Lotto's up to twelve million.",
      "audio": "audio/dialogue/johnny_lotto/take_01/balanced/01_johnny.wav",
      "start": 1.0,
      "duration": 2.98
    },
    {
      "speaker": "Lou",
      "text": "Don't waste your money.",
      "audio": "audio/dialogue/johnny_lotto/lou_full_03/balanced/02_lou.wav",
      "start": 4.18,
      "duration": 1.62
    },
    {
      "speaker": "Johnny",
      "text": "Somebody's gotta win.",
      "audio": "audio/dialogue/johnny_lotto/take_01/balanced/03_johnny.wav",
      "start": 6.0,
      "duration": 1.83
    },
    {
      "speaker": "Lou",
      "text": "I hit it once. Never played again.",
      "audio": "audio/dialogue/johnny_lotto/lou_full_03/balanced/04_lou.wav",
      "start": 8.03,
      "duration": 3.09
    },
    {
      "speaker": "Johnny",
      "text": "You? How much?",
      "audio": "audio/dialogue/johnny_lotto/take_01/balanced/05_johnny.wav",
      "start": 11.32,
      "duration": 2.73
    },
    {
      "speaker": "Lou",
      "text": "Enough to buy this place.",
      "audio": "audio/dialogue/johnny_lotto/lou_full_03/balanced/06_lou.wav",
      "start": 14.25,
      "duration": 2.67
    },
    {
      "speaker": "Johnny",
      "text": "No shit. What'd you do, pick birthdays?",
      "audio": "audio/dialogue/johnny_lotto/take_01/balanced/07_johnny.wav",
      "start": 17.12,
      "duration": 3.78
    },
    {
      "speaker": "Lou",
      "text": "Didn't pick numbers. Picked a truck.",
      "audio": "audio/dialogue/johnny_lotto/lou_full_03/balanced/08_lou.wav",
      "start": 21.1,
      "duration": 2.77
    },
    {
      "speaker": "Johnny",
      "text": "A truck?",
      "audio": "audio/dialogue/johnny_lotto/take_01/balanced/09_johnny.wav",
      "start": 24.07,
      "duration": 1.03
    },
    {
      "speaker": "Lou",
      "text": "Had the bank's name on the side.",
      "audio": "audio/dialogue/johnny_lotto/lou_full_03/balanced/10_lou.wav",
      "start": 25.3,
      "duration": 2.84
    },
    {
      "speaker": "Johnny",
      "text": "Right.",
      "audio": "audio/dialogue/johnny_lotto/take_01/balanced/11_johnny.wav",
      "start": 28.71,
      "duration": 0.73
    },
    {
      "speaker": "Lou",
      "text": "Anyway. I gotta go make a delivery.",
      "audio": "audio/dialogue/johnny_lotto/lou_full_03/balanced/12_lou.wav",
      "start": 30.11,
      "duration": 2.09
    },
    {
      "speaker": "Johnny",
      "text": "Let me do it.",
      "audio": "audio/dialogue/johnny_lotto/take_01/balanced/13_johnny.wav",
      "start": 32.4,
      "duration": 1.33
    },
    {
      "speaker": "Lou",
      "text": "You?",
      "audio": "audio/dialogue/johnny_lotto/lou_full_03/balanced/14_lou.wav",
      "start": 33.93,
      "duration": 0.63
    },
    {
      "speaker": "Johnny",
      "text": "Yeah. I've been in here all day. Let me get out of the store for a bit.",
      "audio": "audio/dialogue/johnny_lotto/take_01/balanced/15_johnny.wav",
      "start": 34.76,
      "duration": 5.18
    },
    {
      "speaker": "Lou",
      "text": "Ya, actually, they... that might not be a bad idea.",
      "audio": "audio/dialogue/johnny_lotto/lou_full_03/balanced/16_lou.wav",
      "start": 40.31,
      "duration": 4.25
    },
    {
      "speaker": "Lou",
      "text": "You just need to take this to the Ostend docks up north west a bit.",
      "audio": "audio/dialogue/johnny_lotto/lou_full_03/balanced/17_lou.wav",
      "start": 45.43,
      "duration": 5.13
    },
    {
      "speaker": "Johnny",
      "text": "Okay I think I know where that is.",
      "audio": "audio/dialogue/johnny_lotto/delivery_01/balanced/18_johnny.wav",
      "start": 56.83,
      "duration": 2.58
    },
    {
      "speaker": "Lou",
      "text": "Devon will be working in the bait and tackle shop, just let him know I sent you.",
      "audio": "audio/dialogue/johnny_lotto/lou_full_03/balanced/19_lou.wav",
      "start": 59.73,
      "duration": 4.8100000000000005
    }
  ]
}
